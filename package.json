{
  "name": "work-status-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node dashboard/api/server.mjs",
    "build": "node --check agent/run-collection.mjs && node --check dashboard/api/worker.mjs && node dashboard/api/build-sites.mjs",
    "test": "node --test",
    "collect": "node agent/run-collection.mjs",
    "collect:raw": "node agent/run-collection.mjs --no-ai",
    "collect:direct-ai": "AI_SUMMARY_PROVIDER=openai node agent/run-collection.mjs",
    "sync:agent-summary": "node dashboard/agent-result-adapter/sync-agent-summary.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "wrangler": "^4.20.0"
  }
}
