[{"file":"public/share.html","data":"<!doctype html>\n<html lang=\"ko\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>작업 현황 갱신 요청</title>\n<style>\n  :root { --err: #d64545; --warn: #d68f00; --ink: #1f2430; --sub: #6b7280; --line: #e5e7eb; --bg: #f6f7f9; }\n  * { box-sizing: border-box; }\n  body { margin: 0; font-family: -apple-system, \"Apple SD Gothic Neo\", \"Noto Sans KR\", sans-serif; color: var(--ink); background: var(--bg); line-height: 1.5; }\n  main { max-width: 760px; margin: 0 auto; padding: 20px 16px 60px; }\n  header { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }\n  header h1 { font-size: 22px; margin: 0 0 4px; }\n  header p { margin: 0; color: var(--sub); font-size: 14px; }\n  .head-text { flex: 1 1 auto; min-width: 220px; }\n  #refresh { border: 1px solid var(--line); background: #fff; border-radius: 10px; padding: 10px 14px; font-size: 14px; font-weight: 600; cursor: pointer; color: var(--ink); }\n  #refresh:disabled { color: var(--sub); cursor: wait; }\n  .kpis { display: flex; gap: 8px; margin: 16px 0; flex-wrap: wrap; }\n  .kpis a { flex: 1 1 30%; min-width: 140px; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; text-decoration: none; color: inherit; }\n  .kpis a strong { display: block; font-size: 22px; }\n  .kpis a.err strong { color: var(--err); }\n  .kpis a.warn strong { color: var(--warn); }\n  .kpis a small { color: var(--sub); }\n  .filter { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; }\n  .filter label { font-size: 13px; color: var(--sub); display: block; margin-bottom: 6px; }\n  .filter select { width: 100%; padding: 8px; font-size: 15px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }\n  details.sec { margin-top: 20px; }\n  details.sec > summary { list-style: none; cursor: pointer; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: flex; align-items: center; gap: 8px; user-select: none; }\n  details.sec > summary::-webkit-details-marker { display: none; }\n  details.sec > summary h2 { font-size: 17px; margin: 0; }\n  details.sec > summary .count { color: var(--err); font-size: 15px; font-weight: 700; }\n  details.sec > summary .chevron { margin-left: auto; color: var(--sub); transition: transform .15s; }\n  details.sec[open] > summary .chevron { transform: rotate(90deg); }\n  details.sec .desc { margin: 10px 2px 12px; color: var(--sub); font-size: 13px; }\n  .item { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; }\n  .item-head { display: flex; gap: 8px; align-items: center; font-size: 12px; flex-wrap: wrap; }\n  .proj { background: #eef2ff; color: #3b4ba0; border-radius: 6px; padding: 2px 8px; font-weight: 600; }\n  .status { color: var(--sub); margin-left: auto; }\n  .badge { border-radius: 6px; padding: 2px 8px; font-weight: 700; color: #fff; }\n  .badge.err { background: var(--err); }\n  .badge.warn { background: var(--warn); }\n  .item h3 { margin: 6px 0 4px; font-size: 15px; }\n  .meta { display: flex; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--sub); }\n  .todo { margin: 8px 0 0; padding-left: 18px; font-size: 13px; }\n  .todo li { margin-bottom: 2px; }\n  .role { color: var(--sub); }\n  .notion { display: inline-block; margin-top: 8px; font-size: 13px; color: #2563eb; text-decoration: none; }\n  .empty { color: var(--sub); padding: 4px 2px; }\n  .hidden { display: none; }\n  #state { color: var(--sub); font-size: 14px; padding: 24px 0; text-align: center; }\n</style>\n</head>\n<body>\n<main>\n<header>\n  <div class=\"head-text\">\n    <h1>📋 작업 현황 갱신 요청</h1>\n    <p id=\"generated\">데이터 불러오는 중…</p>\n  </div>\n  <button id=\"refresh\" type=\"button\">🔄 데이터 갱신</button>\n</header>\n<div id=\"state\">불러오는 중…</div>\n<div id=\"content\" class=\"hidden\">\n  <div class=\"kpis\">\n    <a href=\"#overdue\" class=\"err\"><strong id=\"kpi-overdue\">0</strong><small>기한 초과</small></a>\n    <a href=\"#guide\" class=\"err\"><strong id=\"kpi-guide\">0</strong><small>가이드 위반</small></a>\n    <a href=\"#setup\" class=\"warn\"><strong id=\"kpi-setup\">0</strong><small>진행 준비 필요</small></a>\n  </div>\n  <div class=\"filter\">\n    <label for=\"who\">내 이름을 선택하면 내 항목만 보입니다</label>\n    <select id=\"who\"><option value=\"\">전체 보기</option></select>\n  </div>\n  <details class=\"sec\" id=\"overdue\" open>\n    <summary><h2>⏰ 기한 초과</h2><span class=\"count\"></span><span class=\"chevron\">▶</span></summary>\n    <p class=\"desc\">마감일이 지났습니다. 지연 사유와 변경 일정을 입력해 주세요.</p>\n    <div class=\"items\"></div>\n  </details>\n  <details class=\"sec\" id=\"guide\">\n    <summary><h2>📐 작업 가이드 위반</h2><span class=\"count\"></span><span class=\"chevron\">▶</span></summary>\n    <p class=\"desc\">필수 입력값이 비어 있거나 규칙에 맞지 않습니다. 항목별 안내를 따라 수정해 주세요.</p>\n    <div class=\"items\"></div>\n  </details>\n  <details class=\"sec\" id=\"setup\">\n    <summary><h2>🚦 진행 준비 필요</h2><span class=\"count\"></span><span class=\"chevron\">▶</span></summary>\n    <p class=\"desc\">현재 스프린트인데 아직 시작 전 상태입니다. 담당자·우선순위·기간·브랜치 입력 후 진행 예정으로 변경해 주세요.</p>\n    <div class=\"items\"></div>\n  </details>\n</div>\n<script type=\"module\">\nimport { issuePresentation, issueMatchesCategory } from './dashboard-management.js';\n\nconst closed = new Set(['완료', '일시 정지', '정지', '중단']);\nconst esc = value => String(value ?? '').replace(/[&<>\"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[ch]));\nconst fmtDate = value => value ? String(value).slice(0, 10) : '-';\nconst $ = id => document.getElementById(id);\n\nfunction withIssues(item, allIssues) {\n  return {\n    ...item,\n    issues: item.issues?.length\n      ? item.issues\n      : allIssues.filter(issue => issue.workItemId === item.id || (!issue.workItemId && issue.specId === item.id)),\n  };\n}\n\nfunction issueLines(item, category) {\n  const seen = new Set();\n  const lines = [];\n  for (const issue of (item.issues || []).filter(issue => !category || issueMatchesCategory(issue, category))) {\n    const p = issuePresentation(issue);\n    if (seen.has(p.label)) continue;\n    seen.add(p.label);\n    lines.push(p);\n  }\n  return lines;\n}\n\nfunction card(item, kind) {\n  const assignees = (item.assignees || []).length ? item.assignees : ['담당자 미지정'];\n  const badge = kind === 'overdue'\n    ? `<span class=\"badge err\">${item.overdueDays}일 초과</span>`\n    : kind === 'setup' ? '<span class=\"badge warn\">진행 준비 필요</span>' : '';\n  const category = kind === 'guide' ? 'guide' : kind === 'setup' ? 'readiness' : null;\n  const lines = issueLines(item, category);\n  const todo = lines.length\n    ? `<ul class=\"todo\">${lines.map(p => `<li><strong>${esc(p.label)}</strong> — ${esc(p.recommendedAction)} <span class=\"role\">(${esc(p.responsibleRole)})</span></li>`).join('')}</ul>`\n    : kind === 'overdue' ? '<ul class=\"todo\"><li><strong>지연 기록 필요</strong> — 지연 사유와 변경 일정을 입력하세요.</li></ul>' : '';\n  const link = item.url ? `<a class=\"notion\" href=\"${esc(item.url)}\" target=\"_blank\" rel=\"noopener\">Notion에서 열기 ↗</a>` : '';\n  return `<article class=\"item\" data-assignees=\"${esc(assignees.join('|'))}\">\n    <div class=\"item-head\"><span class=\"proj\">${esc(item.project || '프로젝트 미분류')}</span>${badge}<span class=\"status\">${esc(item.status || '미정')}</span></div>\n    <h3>${esc(item.title || '제목 없음')}</h3>\n    <div class=\"meta\"><span>담당 ${assignees.map(esc).join(', ')}</span><span>기간 ${fmtDate(item.start)} → ${fmtDate(item.due)}</span>${item.sprint ? `<span>${esc(item.sprint)}</span>` : ''}</div>\n    ${todo}${link}\n  </article>`;\n}\n\nfunction applyFilter() {\n  const name = $('who').value;\n  document.querySelectorAll('.item').forEach(el => {\n    el.classList.toggle('hidden', !!name && !el.dataset.assignees.split('|').includes(name));\n  });\n  document.querySelectorAll('details.sec').forEach(sec => {\n    sec.querySelector('.count').textContent = sec.querySelectorAll('.item:not(.hidden)').length + '건';\n  });\n}\n\nfunction render(dashboard) {\n  const allIssues = dashboard.validationIssues || [];\n  const active = (dashboard.workItems || []).filter(item => !closed.has(item.status));\n  const overdue = active.filter(item => item.overdueDays > 0)\n    .map(item => withIssues(item, allIssues))\n    .sort((a, b) => b.overdueDays - a.overdueDays || a.title.localeCompare(b.title, 'ko'));\n  const guide = (dashboard.guideViolationItems || active.filter(item => (item.issues || []).some(issue => issueMatchesCategory(issue, 'guide'))))\n    .filter(item => !closed.has(item.status))\n    .map(item => withIssues(item, allIssues));\n  const setup = (dashboard.progressSetupItems || []).map(item => withIssues(item, allIssues));\n\n  const generated = String(dashboard.generatedAt || '').replace('T', ' ').slice(0, 16);\n  $('generated').textContent = `기준: ${generated} · 아래 항목의 Notion 작업 현황을 오늘 중 갱신해 주세요.`;\n  $('kpi-overdue').textContent = overdue.length;\n  $('kpi-guide').textContent = guide.length;\n  $('kpi-setup').textContent = setup.length;\n  document.querySelector('#overdue .items').innerHTML = overdue.map(item => card(item, 'overdue')).join('') || '<p class=\"empty\">해당 항목이 없습니다. 👍</p>';\n  document.querySelector('#guide .items').innerHTML = guide.map(item => card(item, 'guide')).join('') || '<p class=\"empty\">해당 항목이 없습니다. 👍</p>';\n  document.querySelector('#setup .items').innerHTML = setup.map(item => card(item, 'setup')).join('') || '<p class=\"empty\">해당 항목이 없습니다. 👍</p>';\n\n  const previous = $('who').value;\n  const names = [...new Set([...overdue, ...guide, ...setup]\n    .flatMap(item => (item.assignees || []).length ? item.assignees : ['담당자 미지정']))]\n    .sort((a, b) => a.localeCompare(b, 'ko'));\n  $('who').innerHTML = '<option value=\"\">전체 보기</option>' + names.map(name => `<option${name === previous ? ' selected' : ''}>${esc(name)}</option>`).join('');\n  applyFilter();\n\n  $('state').classList.add('hidden');\n  $('content').classList.remove('hidden');\n}\n\nasync function load() {\n  const res = await fetch('/api/dashboard');\n  if (!res.ok) throw new Error(`대시보드 데이터를 불러오지 못했습니다 (${res.status})`);\n  render(await res.json());\n}\n\nasync function refresh() {\n  const btn = $('refresh');\n  btn.disabled = true;\n  btn.textContent = '⏳ 갱신 중… (1~2분 소요)';\n  try {\n    const res = await fetch('/api/refresh', { method: 'POST' });\n    const raw = await res.text();\n    let body = {};\n    try { body = raw ? JSON.parse(raw) : {}; }\n    catch {\n      const detail = raw.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 180);\n      throw new Error(`서버 수집 실패 (${res.status})${detail ? `: ${detail}` : ''}`);\n    }\n    if (!res.ok) throw new Error(body.message || `서버 수집 실패 (${res.status})`);\n    if (body.dashboard) {\n      render(body.dashboard);\n    } else {\n      // 로컬 서버: 백그라운드 수집 → 완료까지 폴링\n      for (let waited = 0; waited < 10 * 60_000; waited += 5000) {\n        await new Promise(resolve => setTimeout(resolve, 5000));\n        const status = await (await fetch('/api/status')).json();\n        if (!status.collecting) break;\n      }\n      await load();\n    }\n    btn.textContent = '✅ 갱신 완료';\n  } catch (error) {\n    btn.textContent = '⚠️ 갱신 실패 — 다시 시도';\n    console.error(error);\n  }\n  btn.disabled = false;\n  setTimeout(() => { btn.textContent = '🔄 데이터 갱신'; }, 4000);\n}\n\n$('who').addEventListener('change', applyFilter);\n$('refresh').addEventListener('click', refresh);\nload().catch(error => { $('state').textContent = `⚠️ ${error.message}`; });\n</script>\n</main>\n</body>\n</html>\n"},{"file":"public/spec-state.js","data":"import{a}from\"./chunks/chunk-VR5BB4TL.js\";export{a as deriveSpecStatus};\n"},{"file":"public/spec-state.mjs","data":"import{a}from\"../chunks/chunk-OJK5RYMQ.mjs\";export{a as deriveSpecStatus};\n"}]